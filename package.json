{
  "name": "vc-di-eddsa-test-suite",
  "version": "1.0.0",
  "description": "Test suite for the MerkleProof2019 Data Integrity cryptosuite.",
  "main": "/tests",
  "type": "module",
  "directories": {
    "tests": "tests"
  },
  "scripts": {
    "test": "mocha tests/ --reporter @digitalbazaar/mocha-w3c-interop-reporter --reporter-options abstract=\"$PWD/config/abstract.hbs\",reportDir=\"$PWD/reports\",respec=\"$PWD/config/respec.json\",suiteLog='./suite.log',templateData=\"$PWD/reports/index.json\",title=\"Data Integrity Merkle Proof 2019 Interoperability Report 1.0\" --timeout 15000 --preserve-symlinks",
    "lint": "eslint ."
  },
  "author": {
    "name": "Julien Fraichot",
    "url": "https://www.blockcerts.org"
  },
  "contributors": [],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@digitalbazaar/credentials-context": "^3.1.0",
    "@digitalbazaar/data-integrity": "^2.0.0",
    "@digitalbazaar/data-integrity-context": "^2.0.0",
    "@digitalbazaar/did-method-key": "^5.1.0",
    "@digitalbazaar/ed25519-multikey": "^1.0.1",
    "@digitalbazaar/http-client": "^4.0.0",
    "@digitalbazaar/mocha-w3c-interop-reporter": "^1.6.0",
    "@digitalbazaar/multikey-context": "^1.0.0",
    "@digitalbazaar/vc": "^7.0.0",
    "@digitalcredentials/did-context": "^1.0.0",
    "bnid": "^3.0.0",
    "canonicalize": "^2.0.0",
    "chai": "^4.3.6",
    "data-integrity-test-suite-assertion": "github:w3c-ccg/data-integrity-test-suite-assertion",
    "jsonld-document-loader": "^2.0.0",
    "jsonld-signatures-merkleproof2019": "^2.16.0",
    "lodash.clonedeep": "^4.5.0",
    "mocha": "^11.7.0",
    "uuid": "^9.0.0",
    "varint": "^6.0.0",
    "vc-test-suite-implementations": "github:w3c/vc-test-suite-implementations"
  },
  "devDependencies": {
    "eslint": "^8.52.0",
    "eslint-config-digitalbazaar": "^5.0.1",
    "eslint-plugin-jsdoc": "^46.8.2",
    "eslint-plugin-unicorn": "^48.0.1"
  },
  "license": "BSD-3-Clause"
}
